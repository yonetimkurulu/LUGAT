// LÜGAT — PostgreSQL / Supabase Üretim Şeması (Akademik Kaynak ve İştikak Sistemi)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Word {
  id                  String               @id @default(cuid())
  slug                String               @unique
  modernTurkish       String               // örn: "Tenkit" veya "Eleştiri"
  modernEquivalents   String               // JSON array veya virgülle ayrılmış modern karşılıklar
  transliteration     String               // örn: "Tenḳīd"
  primaryOttoman      String               // Arap harfli imla: "تنقيد"
  origin              String               // "Arapça", "Farsça", "Türkçe", "İtalyanca" vb.
  originDetail        String?              // örn: "Arapça n-q-d (نقد) kökünden tef'îl masdarı"
  partOfSpeech        String               // "İsim", "Sıfat", "Fiil", "Zarf", "Edat"
  verificationStatus  String               @default("VERIFIED") // VERIFIED, EDITORIAL, APPROXIMATE, PENDING
  linguisticNotes     String?
  historicalMeaning   String?              // Klasik/Tarihî metinlerdeki asıl anlam
  contemporaryMeaning String?              // Günümüz Türkçesindeki anlamsal karşılık
  persianMorphology   String?              // Farsça terkip/ek yapısı
  turkishSuffixes     String?              // Türkçe yapım ekleri
  isWordOfDay         Boolean              @default(false)
  viewCount           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  meanings           WordMeaning[]
  spellings          WordSpelling[]
  rootRelations      WordRootRelation[]
  examples           ExampleSentence[]
  sourceRelations    WordSourceRelation[]
  categoryRelations  WordCategoryRelation[]
  synonyms           SynonymRelation[]     @relation("WordSynonyms")
  targetSynonyms     SynonymRelation[]     @relation("TargetWordSynonyms")
  collectionItems    CollectionItem[]
  quizQuestions      QuizQuestion[]

  @@index([slug])
  @@index([modernTurkish])
  @@index([primaryOttoman])
  @@index([transliteration])
  @@index([verificationStatus])
}

model WordSpelling {
  id           String  @id @default(cuid())
  wordId       String
  arabicScript String  // örn: "تنقيد", "طَنقِيد"
  spellingType String  // "Klasik İmla", "Matbu İmla", "Harekeli İmla"
  translit     String?
  notes        String?

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([arabicScript])
}

model WordMeaning {
  id         String   @id @default(cuid())
  wordId     String
  orderIndex Int      @default(1)
  definition String   // Temel tanım
  register   String?  // "Hukuk", "Edebiyat", "Felsefe"

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model Root {
  id                      String             @id @default(cuid())
  slug                    String             @unique
  rootLettersModern       String             // örn: "H-K-M"
  rootLettersArabic       String             // örn: "ح-ك-م"
  origin                  String             @default("Arapça")
  primaryMeaning          String             // örn: "Hükmetme, sağlamlaştırma, engelleme"
  description             String?
  rootType                String?            @default("SULASI_SALIM")
  lexicalMeaningArabic    String?
  ottomanUsageScope       String?
  primarySourceCitation   String?
  createdAt               DateTime           @default(now())

  relations               WordRootRelation[]

  @@index([slug])
  @@index([rootLettersModern])
  @@index([rootLettersArabic])
}

model WordRootRelation {
  id                          String   @id @default(cuid())
  wordId                      String
  rootId                      String
  morphologicalPattern        String   // Vezin/Bâb: e.g. "Tef'îl (تَفْعِيل)"
  morphologicalType           String   // "Masdar", "İsm-i Fâil", "İsm-i Mef'ûl"
  relationshipType            String   @default("DIRECT_DERIVATION")
  meaningContribution        String
  semanticShift               String?
  attestationNote             String?
  relationVerificationStatus  String   @default("PRIMARY_VERIFIED")
  orderIndex                  Int      @default(0)

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  root Root @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([wordId, rootId])
  @@index([wordId])
  @@index([rootId])
}

model ExampleSentence {
  id               String  @id @default(cuid())
  wordId           String
  sentenceModern   String
  sentenceOttoman  String?
  sentenceTranslit String?
  author           String?
  sourceWork       String?

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model SynonymRelation {
  id            String  @id @default(cuid())
  wordId        String
  synonymWordId String?
  synonymText   String
  nuanceNote    String?

  word        Word  @relation("WordSynonyms", fields: [wordId], references: [id], onDelete: Cascade)
  synonymWord Word? @relation("TargetWordSynonyms", fields: [synonymWordId], references: [id], onDelete: SetNull)

  @@index([wordId])
  @@index([synonymWordId])
}

model Category {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  description String
  iconName    String

  relations   WordCategoryRelation[]

  @@index([slug])
}

model WordCategoryRelation {
  id         String   @id @default(cuid())
  wordId     String
  categoryId String

  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([wordId, categoryId])
  @@index([wordId])
  @@index([categoryId])
}

model Source {
  id            String               @id @default(cuid())
  code          String?              @unique
  title         String
  author        String
  year          String?
  publisher     String?
  edition       String?
  sourceType    String               @default("PRIMARY_LEXICON")
  language      String               @default("Osmanlı Türkçesi")
  digitalUrl    String?
  copyrightNote String?
  description   String?
  relations     WordSourceRelation[]

  @@index([code])
}

model WordSourceRelation {
  id                String   @id @default(cuid())
  wordId            String
  sourceId          String
  volume            String?
  pageNumber        String?
  entryHeadword     String?
  citation          String?
  verificationLevel String   @default("PRIMARY_VERIFIED")
  verifiedAt        DateTime @default(now())

  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([wordId, sourceId])
  @@index([wordId])
  @@index([sourceId])
}

model VocabularyCollection {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String
  isFeatured  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]

  @@index([slug])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  wordId       String
  note         String?
  createdAt    DateTime @default(now())

  collection VocabularyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  word       Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([collectionId, wordId])
  @@index([collectionId])
  @@index([wordId])
}

model QuizQuestion {
  id            String  @id @default(cuid())
  type          String
  prompt        String
  targetScript  String?
  options       String
  correctAnswer String
  explanation   String
  relatedWordId String?

  relatedWord Word? @relation(fields: [relatedWordId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([relatedWordId])
}

model LibraryText {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  titleOttoman    String
  author          String
  authorOttoman   String?
  genre           String
  period          String
  century         String?
  summary         String
  contentOttoman  String
  contentTranslit String
  contentModern   String
  vocabularyJson  String?
  readTime        String   @default("5 dk")
  difficulty      String   @default("Orta")
  isFeatured      Boolean  @default(false)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([genre])
  @@index([author])
  @@index([isFeatured])
}
